{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/leverimmy/conference-countdown/main/data/schema.json",
  "title": "Conference Countdown current.json",
  "description": "The canonical current-conference format consumed by the macOS app and generated feed.",
  "$ref": "#/$defs/current",
  "$defs": {
    "event": {
      "type": "object",
      "required": ["id", "title", "compact_title", "at", "date_label", "detail_label", "symbol"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "compact_title": { "type": "string", "minLength": 1 },
        "at": { "type": ["string", "null"], "format": "date-time" },
        "date_label": { "type": "string" },
        "detail_label": { "type": "string" },
        "symbol": { "type": "string", "minLength": 1 },
        "historical_key": {
          "type": ["string", "null"],
          "enum": [
            "abstract_deadline",
            "paper_deadline",
            "commitment_deadline",
            "review_release",
            "rebuttal_deadline",
            "final_decision",
            "conference_start",
            null
          ]
        },
        "target_year": { "type": ["integer", "null"], "minimum": 2000, "maximum": 2200 }
      },
      "additionalProperties": false
    },
    "current": {
      "type": "object",
      "required": [
        "schema_version",
        "last_verified",
        "id",
        "edition",
        "name",
        "short_name",
        "subtitle",
        "symbol",
        "official_url",
        "time_zone",
        "default_event_id",
        "events"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "last_verified": { "type": "string", "format": "date" },
        "id": { "type": "string" },
        "edition": { "type": "integer" },
        "name": { "type": "string" },
        "short_name": { "type": "string" },
        "subtitle": { "type": "string" },
        "symbol": { "type": "string" },
        "official_url": { "type": "string", "format": "uri" },
        "time_zone": { "type": "string" },
        "default_event_id": { "type": "string" },
        "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/event" } }
      },
      "additionalProperties": false
    }
  }
}
